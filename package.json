{
  "name": "mimir-desktop",
  "version": "0.0.3",
  "description": "Mimir Desktop - 以 Agent 为核心的科研工作台",
  "main": "out/main/index.js",
  "author": {
    "name": "Mimir",
    "email": "hxhy@users.noreply.github.com"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:headed": "electron-vite build && playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:eval": "vitest run test/unit/evalMetrics.test.ts test/unit/evalHarness.test.ts",
    "eval": "node --experimental-strip-types --no-warnings test/eval/cli.ts",
    "eval:real": "vitest run test/eval/realAgentEval.test.ts",
    "eval:compare": "node --experimental-strip-types --no-warnings test/eval/cli.ts --compare",
    "test:gateway": "vitest run test/gateway",
    "test:model-discovery": "node --experimental-strip-types --no-warnings electron/modelDiscovery.test.ts",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@arizeai/openinference-instrumentation-langchain": "^4.1.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/openai": "^1.5.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@retorquere/bibtex-parser": "^11.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "deepagents": "^1.13.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.0",
    "ffmpeg-static": "^5.3.0",
    "gpt-tokenizer": "^4.0.0",
    "js-yaml": "^5.4.1",
    "langchain": "^1.5.10",
    "langsmith": "^0.9.0",
    "lucide-react": "^0.454.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "sherpa-onnx": "^1.13.7",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "ffmpeg-static"
    ],
    "ignoredBuiltDependencies": [
      "node-pty"
    ]
  }
}
